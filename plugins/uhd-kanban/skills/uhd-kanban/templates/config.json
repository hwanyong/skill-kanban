{
  "columns": [
    { "dir": "1-to-do", "status": "to-do", "types": ["task", "bug", "decision"] },
    { "dir": "2-in-progress", "status": "in-progress", "types": ["task", "bug", "decision"] },
    { "dir": "3-in-review", "status": "in-review", "types": ["task", "bug"] },
    { "dir": "4-done", "status": "done", "types": ["task", "bug", "decision", "milestone"] },
    { "dir": "5-decided", "status": "decided", "types": ["decision"] },
    { "dir": "6-planned", "status": "planned", "types": ["milestone"] },
    { "dir": "7-implemented", "status": "implemented", "types": ["decision"] },
